# small MariaDB settings so it fits in Render's free 512 MB
[mysqld]
bind-address            = 127.0.0.1
performance_schema      = OFF
innodb_buffer_pool_size = 32M
innodb_log_buffer_size  = 4M
key_buffer_size         = 4M
max_connections         = 30
table_open_cache        = 200
thread_cache_size       = 4
tmp_table_size          = 8M
max_heap_table_size     = 8M
skip-name-resolve
